{
  "manifest_version": 3,
  "name": "Chess Move Helper",
  "version": "1.4.0",
  "description": "Scans Chess.com boards and uses Maia 3 as the move predictor with optional randomized Polyglot opening books.",
  "action": {
    "default_title": "Chess Move Helper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "player-side-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine-worker.js",
        "maia3/*",
        "ort.min.js"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}