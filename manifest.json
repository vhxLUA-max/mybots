{
  "manifest_version": 3,
  "name": "Chess Move Helper",
  "version": "1.3.0",
  "description": "Scans Chess.com boards and analyzes positions locally with a built-in chess engine and Polyglot opening books.",
  "action": {
    "default_title": "Chess Move Helper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["engine.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["https://www.chess.com/*"]
}
