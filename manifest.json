{
  "manifest_version": 3,
  "name": "Chess Move Helper",
  "version": "1.0.0",
  "description": "Reads Chess.com analysis positions and shows the current Stockfish move as an arrow.",
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/analysis*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["https://www.chess.com/*"]
}
