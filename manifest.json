{
  "manifest_version": 3,
  "name": "Chess Move Helper",
  "version": "1.1.0",
  "description": "Scans Chess.com boards and analyzes positions locally with a built-in chess engine.",
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["engine.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": ["https://www.chess.com/*"]
}
